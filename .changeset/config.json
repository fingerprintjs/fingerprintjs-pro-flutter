{
  "$schema": "https://unpkg.com/@changesets/config@3.1.4/schema.json",
  "changelog": [
    "@fingerprintjs/changesets-native-dependency-format",
    {
      "repo": "fingerprintjs/flutter",
      "packageName": "fingerprint_flutter",
      "ios": {
        "podspecPath": "ios/fingerprint_flutter.podspec",
        "dependencyName": "Fingerprint-iOS"
      },
      "android": {
        "path": "android",
        "gradleTaskName": "printFingerprintNativeSDKVersion"
      }
    }
  ],
  "commit": false,
  "fixed": [],
  "linked": [],
  "access": "restricted",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [],
  "privatePackages": {
    "version": true,
    "tag": true
  }
}
